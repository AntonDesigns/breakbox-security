<?xml version="1.0" encoding="utf-8"?>
<!-- breakbox-security consumes BreakBox.Core + BreakBox.Generator from GitHub Packages (published by
     breakbox-api), the SLSA / supply-chain single source of truth. On CI, setup-dotnet adds the
     GitHub Packages source authenticated with the PACKAGES_TOKEN secret, so this file only pins
     nuget.org. Two rules keep CI working:
       1. No <clear /> here. It wiped the source setup-dotnet added, so the runner never saw
          nuget.pkg.github.com and every restore failed.
       2. No local .local-nuget folder as a source. It is gitignored, so it does not exist on the
          runner (NU1301).
     For local dev, add the GitHub Packages source once with the dotnet nuget add source command,
     pointing at https://nuget.pkg.github.com/AntonDesigns/index.json, with your GitHub username and a
     read:packages PAT as the password. MAH6 = 0x4D414836. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
