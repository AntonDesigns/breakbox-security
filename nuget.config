<?xml version="1.0" encoding="utf-8"?>
<!-- breakbox-security consumes BreakBox.Core and BreakBox.Generator as versioned packages
     (they live in breakbox-api). Dev uses the local feed below; the expert step is GitHub
     Packages with signing + provenance (uncomment once a PAT is configured). MAH6. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="breakbox-local" value=".local-nuget" />
    <!-- <add key="github" value="https://nuget.pkg.github.com/AntonDesigns/index.json" /> -->
  </packageSources>
</configuration>
