<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BreakBox.Studio.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="Bg">#0c0e11</SolidColorBrush>
        <!-- Panels are glossy, top-lit gradients now, and slightly translucent so the window's acrylic
             blur shows through them as frosted glass. -->
        <LinearGradientBrush x:Key="Panel" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#D11f2833" />
            <GradientStop Offset="1" Color="#D1151b24" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Panel2" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#A6141a23" />
            <GradientStop Offset="1" Color="#A60f141b" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Line">#262c34</SolidColorBrush>
        <SolidColorBrush x:Key="LineBright">#3a434f</SolidColorBrush>
        <SolidColorBrush x:Key="Text">#cdd3da</SolidColorBrush>
        <SolidColorBrush x:Key="Dim">#7c8590</SolidColorBrush>
        <!-- A calm, desaturated steel accent instead of a neon amber: keeps the dark toolkit look,
             drops the warm glow. Primary is the near-white action button, matching the level apps. -->
        <SolidColorBrush x:Key="Accent">#7e96b3</SolidColorBrush>
        <SolidColorBrush x:Key="Primary">#e6e8ea</SolidColorBrush>
        <SolidColorBrush x:Key="Green">#86ab8d</SolidColorBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource Bg}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace" />
        </Style>

        <!-- left-rail nav buttons -->
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1a1f27" />
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#3A7E96B3" />
                    <GradientStop Offset="1" Color="#147E96B3" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Button.nav:disabled">
            <Setter Property="Foreground" Value="#4a515b" />
        </Style>

        <!-- primary action button: a restrained near-white fill, not a neon accent -->
        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="#15181d" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#FFFFFF" />
                    <GradientStop Offset="1" Color="#DDE1E6" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- section header on a card -->
        <Style Selector="TextBlock.cardhead">
            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.5" />
        </Style>

        <!-- roomier tree rows so the structure does not feel crowded -->
        <Style Selector="TreeViewItem">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0,1" />
        </Style>

        <!-- selection in a cool neutral grey, not the Windows system accent (which can be red/blue) -->
        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#1e242c" />
        </Style>
        <Style Selector="TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#27303a" />
        </Style>
        <Style Selector="TreeViewItem:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#27303a" />
        </Style>
        <Style Selector="TreeViewItem:selected:focus:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#2c3642" />
        </Style>

        <!-- glossy cards: a soft drop shadow so the frosted panels lift off the acrylic ground -->
        <Style Selector="Border.card">
            <Setter Property="BoxShadow" Value="0 18 44 -20 #CC000000" />
        </Style>

        <!-- draggable divider between the two panes -->
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource LineBright}" />
        </Style>
    </Application.Styles>
</Application>
