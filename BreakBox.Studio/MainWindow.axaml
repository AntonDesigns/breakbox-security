<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
        x:Class="BreakBox.Studio.MainWindow"
        Title="BreakBox Studio"
        Width="980" Height="640" MinWidth="760" MinHeight="480"
        Background="{DynamicResource Bg}">

    <DockPanel>
        <!-- top bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="BreakBox" Foreground="{DynamicResource Text}" FontWeight="Bold" FontSize="15" />
                    <TextBlock Text="// toolkit" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="0x4D414836" Foreground="{DynamicResource Accent}" FontSize="12"
                           VerticalAlignment="Center" ToolTip.Tip="author signature (MAH6)" />
            </Grid>
        </Border>

        <!-- left nav -->
        <Border DockPanel.Dock="Left" Width="210" Background="{DynamicResource Panel2}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="10,14">
            <StackPanel Spacing="3">
                <TextBlock Text="TOOLS" Foreground="{DynamicResource Dim}" FontSize="11" Margin="6,0,0,8" />
                <Button x:Name="NavPeek" Classes="nav" Click="OnNav" Tag="peek" Content="Peek" />
                <Button x:Name="NavKeygen" Classes="nav" Click="OnNav" Tag="keygen" Content="Keygen" />
                <Button x:Name="NavFlip" Classes="nav" Click="OnNav" Tag="flip" Content="Flip" />
                <TextBlock Text="own generated targets only / authorized use"
                           Foreground="{DynamicResource Dim}" FontSize="10" Margin="6,20,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- content -->
        <Panel>
            <!-- PEEK: X-ray view, a type tree on the left and the selected method's IL on the right -->
            <Grid x:Name="PeekPanel" Margin="28,24,28,24" RowDefinitions="Auto,Auto,*">
                <!-- header -->
                <StackPanel Grid.Row="0" Spacing="6">
                    <TextBlock Text="Peek" Foreground="{DynamicResource Text}" FontSize="24" FontWeight="Bold" />
                    <TextBlock TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" Foreground="{DynamicResource Dim}"
                               Text="X-ray a .NET assembly without running it. The tree on the left is its real structure; pick a method to read its strings and decoded IL. The method marked check is where the licence decision lives." />
                </StackPanel>

                <!-- toolbar + live stats -->
                <Border Grid.Row="1" Margin="0,18,0,0" Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <Button Grid.Column="0" Classes="primary" Click="OnOpenDll" Content="Open .dll…" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="PeekTarget" Text="no target loaded" Foreground="{DynamicResource Text}" FontWeight="SemiBold" />
                            <TextBlock Text="read only  ·  never executed" Foreground="{DynamicResource Dim}" FontSize="11" />
                        </StackPanel>
                        <StackPanel x:Name="PeekStats" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- structure | detail -->
                <Grid Grid.Row="2" Margin="0,16,0,0" ColumnDefinitions="340,8,*">
                    <Border Grid.Column="0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="16,11" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                <TextBlock Text="STRUCTURE" Classes="cardhead" />
                            </Border>
                            <ScrollViewer>
                                <TreeView x:Name="PeekTree" Background="Transparent" Padding="8,8"
                                          SelectionChanged="OnMethodSelected" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns"
                                  HorizontalAlignment="Stretch" />

                    <Border Grid.Column="2" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                            BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="18,11" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                                <TextBlock Text="DETAIL" Classes="cardhead" />
                            </Border>
                            <ScrollViewer>
                                <StackPanel x:Name="PeekDetail" Margin="20,18" Spacing="14">
                                    <TextBlock Text="Open a .dll, then pick a method from the tree."
                                               Foreground="{DynamicResource Dim}" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- KEYGEN: reverse the Level 2 serial, step by step -->
            <Grid x:Name="KeygenPanel" Margin="26" RowDefinitions="Auto,Auto,Auto,*" IsVisible="False">
                <TextBlock Text="Keygen" Foreground="{DynamicResource Text}" FontSize="22" FontWeight="Bold" />
                <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,6,0,14" Foreground="{DynamicResource Dim}"
                           Text="Reverse the Level 2 serial. The serial is not stored in the program, it is computed from a Seed, so Peek cannot find it. This walks the reverse step by step, lets you work out the serial yourself, and only reveals it when you choose." />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                    <Button Classes="primary" Click="OnOpenLevel2" Content="Open Level 2 .dll…" />
                    <TextBlock x:Name="KgTarget" Text="no target loaded" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer Grid.Row="3" Margin="0,16,0,0">
                    <StackPanel x:Name="KgSteps" Spacing="12" />
                </ScrollViewer>
            </Grid>

            <!-- FLIP: patch the client-side gate so it always returns true -->
            <Grid x:Name="FlipPanel" Margin="28,24,28,24" RowDefinitions="Auto,Auto,*" IsVisible="False">
                <StackPanel Grid.Row="0" Spacing="6">
                    <TextBlock Text="Flip" Foreground="{DynamicResource Text}" FontSize="24" FontWeight="Bold" />
                    <TextBlock TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" Foreground="{DynamicResource Dim}"
                               Text="Patch a client-side licence gate. Flip finds the method that decides whether a feature is unlocked, a bool like IsPremium() that returns false, and rewrites its body to always return true. It reads and rewrites the file with Mono.Cecil and never runs it." />
                </StackPanel>

                <Border Grid.Row="1" Margin="0,18,0,0" Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*">
                        <Button Grid.Column="0" Classes="primary" Click="OnOpenFlipDll" Content="Open .dll…" />
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="FlipTarget" Text="no target loaded" Foreground="{DynamicResource Text}" FontWeight="SemiBold" />
                            <TextBlock Text="offline  ·  reads and rewrites, never runs" Foreground="{DynamicResource Dim}" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="2" Margin="0,16,0,0">
                    <StackPanel x:Name="FlipDetail" Spacing="14">
                        <TextBlock Text="Open a generated target (for example Level3.dll, Pixler) to find and flip its gate."
                                   Foreground="{DynamicResource Dim}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Panel>
    </DockPanel>
</Window>
